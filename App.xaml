<Application x:Class="DeepSeekPet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>

    <SolidColorBrush x:Key="AccentBrush" Color="#4D6BFE"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3F5DF0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDF1FF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#23293A"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#8A93A6"/>
    <SolidColorBrush x:Key="LineBrush" Color="#EEF1F7"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F2F4FA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6EAF4"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#2A3B66" Opacity="0.20"/>

    <!-- 小图标按钮 -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#5A6478"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F0F2F9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E4E8F3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="#4D6BFE" Padding="18,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3F5DF0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3553E4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次级按钮 -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#3A4256"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="#F3F5FA" Padding="18,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E9EDF6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DFE5F1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 危险按钮 -->
    <Style x:Key="DangerBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#D64545"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="#FDEEEE" Padding="18,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FADDDD"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F5CCCC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框 -->
    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#23293A"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="8" Background="White" BorderThickness="1" BorderBrush="#DFE4F0">
              <ScrollViewer x:Name="PART_ContentHost" Margin="9,0" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C6D0EC"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#4D6BFE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 圆形勾选框 -->
    <Style x:Key="CheckStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="#C9D1E8" Background="White"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Path x:Name="chk" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M1.2,4.6 L4.4,7.8 L10.2,1.4" Stroke="White" StrokeThickness="1.9"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#4D6BFE"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#4D6BFE"/>
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#4D6BFE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 星期 / 模式 胶囊按钮 -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#3A4256"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="9" Background="#F3F5FA" BorderThickness="1" BorderBrush="#E4E8F2" Padding="10,0" MinWidth="34" Height="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#A9B8F5"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4D6BFE"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D6BFE"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChipRadio" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#3A4256"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="9" Background="#F3F5FA" BorderThickness="1" BorderBrush="#E4E8F2" Padding="14,0" Height="30">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#A9B8F5"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4D6BFE"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D6BFE"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 表单标签 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A93A6"/>
      <Setter Property="Margin" Value="0,13,0,6"/>
    </Style>

    <!-- 右键菜单 -->
    <Style TargetType="{x:Type ContextMenu}">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#23293A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E4E8F2"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="HasDropShadow" Value="True"/>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#23293A"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- 下拉框 -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </Application.Resources>
</Application>
