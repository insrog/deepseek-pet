<Window x:Class="DeepSeekPet.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeekPet"
        Width="204" Height="252"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource AppFont}">
  <Grid x:Name="StageRoot" Background="{x:Null}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 桌宠交互区 -->
    <Grid x:Name="PetArea" Grid.Row="1" Width="180" Height="180"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
          Background="{x:Null}"
          MouseLeftButtonDown="PetArea_MouseLeftButtonDown"
          MouseMove="PetArea_MouseMove"
          MouseLeftButtonUp="PetArea_MouseLeftButtonUp"
          MouseRightButtonUp="PetArea_MouseRightButtonUp"
          MouseEnter="PetArea_MouseEnter">

      <!-- 悬浮层（待机漂浮） -->
      <Grid x:Name="FloatHost">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="FloatT" X="0" Y="0"/>
        </Grid.RenderTransform>
        <!-- 本体层（呼吸 / 倾斜 / 跳动） -->
        <Grid x:Name="PetHost" RenderTransformOrigin="0.5,1">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
              <RotateTransform x:Name="TiltT" Angle="0"/>
              <TranslateTransform x:Name="JumpT" X="0" Y="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Image x:Name="PetImage" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Cursor="SizeAll"/>
        </Grid>
      </Grid>

      <!-- 地面投影（静态，不随悬浮移动） -->
      <Ellipse x:Name="GroundShadow" Width="88" Height="15"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3"
               IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#34000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- 提醒角标 -->
      <Border x:Name="AlertMark" Opacity="0" Width="26" Height="26" CornerRadius="13"
              Background="#FF5A5F" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="4,0,10,0" IsHitTestVisible="False">
        <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- 贴边隐藏后的可见小把手（右键菜单与桌宠/托盘统一） -->
    <Border x:Name="DockTab" Grid.RowSpan="2" Visibility="Collapsed"
            CornerRadius="7" Background="#4D6BFE" Cursor="Hand" Opacity="0.94"
            HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="58"
            MouseEnter="DockTab_MouseEnter"
            MouseRightButtonUp="DockTab_MouseRightButtonUp">
      <TextBlock Text="🐳" FontSize="10" Foreground="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
