<Window x:Class="DeepSeekPet.Windows.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" Background="#FFFFFF"
        FontFamily="{StaticResource AppFont}">
  <StackPanel Margin="20,16,20,18">
    <TextBlock x:Name="TitleLabel" Text="新建任务" FontSize="15" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"/>

    <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="TbTitle" Style="{StaticResource InputBox}" MaxLength="40"/>

    <TextBlock Text="重复方式" Style="{StaticResource FieldLabel}"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="RbInterval" Style="{StaticResource ChipRadio}" Content="按天"
                   IsChecked="True" GroupName="RepeatMode"/>
      <RadioButton x:Name="RbWeekly" Style="{StaticResource ChipRadio}" Content="每周指定"
                   Margin="8,0,0,0" GroupName="RepeatMode"/>
      <RadioButton x:Name="RbOnce" Style="{StaticResource ChipRadio}" Content="仅一次"
                   Margin="8,0,0,0" GroupName="RepeatMode"
                   ToolTip="只在指定日期的某个时刻提醒一次（AI 创建「明天9点提醒我」用的就是这种）"/>
    </StackPanel>

    <Grid Margin="0,12,0,0" MinHeight="30">
      <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="每" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        <TextBox x:Name="TbInterval" Style="{StaticResource InputBox}" Width="56" Text="1"
                 HorizontalContentAlignment="Center" Margin="8,0"/>
        <TextBlock Text="天提醒一次（1 = 每天）" FontSize="13" Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel x:Name="WeeklyPanel" Orientation="Horizontal" Visibility="Collapsed">
        <ToggleButton x:Name="Wd1" Style="{StaticResource ChipToggle}" Content="一"/>
        <ToggleButton x:Name="Wd2" Style="{StaticResource ChipToggle}" Content="二" Margin="6,0,0,0"/>
        <ToggleButton x:Name="Wd3" Style="{StaticResource ChipToggle}" Content="三" Margin="6,0,0,0"/>
        <ToggleButton x:Name="Wd4" Style="{StaticResource ChipToggle}" Content="四" Margin="6,0,0,0"/>
        <ToggleButton x:Name="Wd5" Style="{StaticResource ChipToggle}" Content="五" Margin="6,0,0,0"/>
        <ToggleButton x:Name="Wd6" Style="{StaticResource ChipToggle}" Content="六" Margin="6,0,0,0"/>
        <ToggleButton x:Name="Wd7" Style="{StaticResource ChipToggle}" Content="日" Margin="6,0,0,0"/>
      </StackPanel>
      <StackPanel x:Name="OncePanel" Orientation="Horizontal" Visibility="Collapsed">
        <TextBlock Text="日期" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        <TextBox x:Name="TbOnceDate" Style="{StaticResource InputBox}" Width="112"
                 HorizontalContentAlignment="Center" Margin="8,0"/>
        <TextBlock Text="（格式 2026-10-15，仅当天提醒一次）" FontSize="11"
                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="提醒时间" Style="{StaticResource FieldLabel}"/>
    <StackPanel Orientation="Horizontal">
      <ComboBox x:Name="CbHour" Width="72"/>
      <TextBlock Text=":" FontSize="14" Margin="6,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="CbMinute" Width="72"/>
      <TextBlock Text="到点会在桌宠头顶弹出提醒" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                 Margin="12,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
               Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

    <Grid Margin="0,18,0,0">
      <Button x:Name="BtnDelete" Style="{StaticResource DangerBtn}" Content="删除"
              HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnDelete_Click"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource GhostBtn}" Content="取消" Click="BtnCancel_Click"/>
        <Button Style="{StaticResource PrimaryBtn}" Content="保存" Margin="8,0,0,0" Click="BtnSave_Click"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
