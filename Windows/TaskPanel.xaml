<Window x:Class="DeepSeekPet.Windows.TaskPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeekPet 任务"
        Width="352" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource AppFont}">
  <Grid x:Name="RootGrid" Margin="9">
    <Border x:Name="Card" Background="White" CornerRadius="14" BorderThickness="1"
            BorderBrush="{StaticResource CardBorderBrush}" Effect="{StaticResource CardShadow}">
      <StackPanel>
        <!-- 头部 -->
        <Grid Margin="14,10,8,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🐳" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderText" Text="今日任务" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAdd" Style="{StaticResource IconBtn}" Content="＋" FontSize="14"
                    ToolTip="新建任务" Click="BtnAdd_Click"/>
            <Button x:Name="BtnClose" Style="{StaticResource IconBtn}" Content="×" FontSize="15"
                    ToolTip="收起（点一下桌宠可再次打开）" Margin="2,0,0,0" Click="BtnClose_Click"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{StaticResource LineBrush}"/>

        <!-- 任务列表 -->
        <ScrollViewer MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TaskList" Margin="8,8,8,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="34" Margin="0,1">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Background" Value="Transparent"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#F7F8FC"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Highlight}" Value="True">
                          <Setter Property="Background" Value="#EFF3FF"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="42"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" Style="{StaticResource CheckStyle}"
                            IsChecked="{Binding DoneToday, Mode=OneWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip="标记今天已完成（今天不再提醒）" Click="TaskDone_Click"/>
                  <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="#3D65F0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DoneToday}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                            <Setter Property="Foreground" Value="#9AA2B5"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Grid.Column="3" Background="#EFF2FB" CornerRadius="6" Padding="6,2"
                          VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="{Binding TagText}" FontSize="10" Foreground="#5A6BC0"/>
                  </Border>
                  <Button Grid.Column="4" Style="{StaticResource IconBtn}" Width="36" Height="24" FontSize="11"
                          Content="编辑" Click="TaskEdit_Click"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint" Text="还没有任务，点右上角 ＋ 新建一个吧" FontSize="12"
                   Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,18" HorizontalAlignment="Center"/>
        <Border Height="1" Background="{StaticResource LineBrush}"/>
        <TextBlock x:Name="FooterText" Text="" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                   Margin="14,7,14,8" TextTrimming="CharacterEllipsis"/>

        <!-- ===================== 聊天区 ===================== -->
        <Border Height="1" Background="{StaticResource LineBrush}"/>
        <Grid Margin="10,7,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 聊天标题行 -->
          <Grid Grid.Row="0" Margin="2,0,2,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="💬" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock x:Name="ChatTitle" Text="和鲸鱼娘说说话" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="ChatStatus" Text="" FontSize="10.5" Foreground="#4D6BFE"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <Button x:Name="BtnClearChat" Style="{StaticResource IconBtn}" Content="🧹" FontSize="11"
                      Width="22" Height="22" ToolTip="清空对话记忆（重启后不再显示）" Click="BtnClearChat_Click"/>
            </StackPanel>
          </Grid>

          <!-- 消息列表（增量追加，只更新变化的 TextBlock） -->
          <Border Grid.Row="1" CornerRadius="10" Background="#F7F8FC" Padding="6,4">
            <ScrollViewer x:Name="ChatScroll" Height="172" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="ChatList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,2.5">
                      <Border x:Name="Bub" CornerRadius="9" Padding="9,6" MaxWidth="256"
                              HorizontalAlignment="Left" Background="White" BorderThickness="1"
                              BorderBrush="#E8ECF6">
                        <TextBlock x:Name="Txt" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" LineHeight="17"/>
                      </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter TargetName="Bub" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="Bub" Property="Background" Value="#4D6BFE"/>
                        <Setter TargetName="Bub" Property="BorderBrush" Value="#4D6BFE"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- 输入行 -->
          <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInput" Style="{StaticResource InputBox}" Height="30" FontSize="12"
                     VerticalContentAlignment="Center" MaxLength="500"
                     ToolTip="试试：「明天9点提醒我开会」「今天有什么待办」「帮我搜下明天天气」"
                     KeyDown="ChatInput_KeyDown"/>
            <Button x:Name="BtnSend" Grid.Column="1" Content="发送" Width="52" Height="30" Margin="6,0,0,0"
                    Cursor="Hand" Foreground="White" FontSize="12" Click="BtnSend_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bg" CornerRadius="8" Background="#4D6BFE">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3F5DF0"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3553E4"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.55"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 指向桌宠的小尾巴（运行期计算位置） -->
    <Path x:Name="TailDown" Panel.ZIndex="2" Data="M0,0 L12,0 L6,7 Z" Fill="White"
          HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="162,0,0,2"
          Width="12" Height="7" Stretch="None"/>
    <Path x:Name="TailUp" Panel.ZIndex="2" Visibility="Collapsed" Data="M0,7 L12,7 L6,0 Z" Fill="White"
          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="162,2,0,0"
          Width="12" Height="7" Stretch="None"/>
  </Grid>
</Window>
